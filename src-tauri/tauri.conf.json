{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maratón del Conocimiento",
  "version": "0.1.0",
  "identifier": "com.maratonconocimiento.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Maratón del Conocimiento", "width": 1100, "height": 850, "minWidth": 420, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": [] }
}
